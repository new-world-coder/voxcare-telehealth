# PulseCare Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Google Cloud Platform Configuration
# =============================================================================
GCP_PROJECT_ID=your-gcp-project-id
GKE_CLUSTER=pulsecare-cluster
GKE_ZONE=us-central1-a
GCR_REPOSITORY=gcr.io/your-gcp-project-id

# Service Account Key (JSON file path or content)
GCP_SA_KEY=path/to/service-account-key.json

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulsecare
POSTGRES_USER=pulsecare
POSTGRES_PASSWORD=pulsecare123

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=pulsecare
MONGO_USER=pulsecare
MONGO_PASSWORD=pulsecare123

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# =============================================================================
# External Services
# =============================================================================
# SendGrid (Email notifications)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_ENABLED=false

# Jitsi (Telehealth)
JITSI_BASE_URL=https://meet.jit.si
JITSI_APP_ID=your-jitsi-app-id
JITSI_APP_SECRET=your-jitsi-app-secret

# =============================================================================
# Monitoring and Observability
# =============================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=true
GRAFANA_PORT=3002
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# Feature Flags
# =============================================================================
# Kafka (Domain events)
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Audit logging
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_LEVEL=INFO

# =============================================================================
# Security Configuration
# =============================================================================
# CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# =============================================================================
# Development Configuration
# =============================================================================
# Spring profiles
SPRING_PROFILES_ACTIVE=local

# Logging
LOG_LEVEL=INFO
LOG_LEVEL_COM_PULSECARE=DEBUG

# =============================================================================
# Kubernetes Configuration (for local development)
# =============================================================================
# Local Kubernetes context
KUBE_CONTEXT=docker-desktop

# Namespace
K8S_NAMESPACE=pulsecare

# =============================================================================
# Load Testing Configuration
# =============================================================================
# k6 load testing
K6_ENABLED=false
K6_DURATION=300
K6_RATE=100
K6_CONCURRENT_USERS=10

# =============================================================================
# CI/CD Configuration
# =============================================================================
# GitHub Actions
GITHUB_TOKEN=your-github-token
GITHUB_REPOSITORY=your-username/pulsecare-telehealth

# Docker registry
DOCKER_REGISTRY=gcr.io
DOCKER_USERNAME=_json_key
DOCKER_PASSWORD=your-gcp-sa-key

# =============================================================================
# Health Check Configuration
# =============================================================================
# Service health check intervals
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# =============================================================================
# Backup and Recovery
# =============================================================================
# Database backup
BACKUP_ENABLED=false
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# =============================================================================
# Performance Configuration
# =============================================================================
# Connection pools
DB_CONNECTION_POOL_SIZE=10
DB_CONNECTION_POOL_MAX_SIZE=20

# Cache configuration
CACHE_ENABLED=true
CACHE_TTL=300

# =============================================================================
# Notification Configuration
# =============================================================================
# Email notifications
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_FROM=noreply@pulsecare.com
EMAIL_REPLY_TO=support@pulsecare.com

# SMS notifications (optional)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# =============================================================================
# Voice AI / GetDial (appointment booking + reminders)
# Pattern derived from EstateCraft DialVoiceProvider
# =============================================================================
# mock = local without external APIs (default)
# dial = GetDial production voice + SMS (https://getdial.ai)
VOICE_PROVIDER=mock
VOICE_SERVICE_PORT=8087
DIAL_API_KEY=
DIAL_BASE_URL=https://api.getdial.ai
DIAL_FROM_NUMBER_ID=
DIAL_WEBHOOK_SECRET=
VOICE_MAX_RETRIES=3
VOICE_RETRY_DELAY_MINUTES=30
VOICE_SMS_FALLBACK_ENABLED=true
VOICE_DEFAULT_CLINIC_NAME=PulseCare

# =============================================================================
# Telehealth Configuration
# =============================================================================
# Session management
TELEHEALTH_SESSION_TIMEOUT=3600
TELEHEALTH_MAX_PARTICIPANTS=10
TELEHEALTH_RECORDING_ENABLED=false

# Room configuration
TELEHEALTH_ROOM_PREFIX=pulsecare
TELEHEALTH_ROOM_LENGTH=8
